{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandwichHardwareProfile",
  "description": "Hardware profile schema for sandwich.cpp auto-dispatch and tiering engine",
  "type": "object",
  "required": ["timestamp", "os", "cpu", "ram", "gpu", "storage", "invariants"],
  "properties": {
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of profile generation"
    },
    "os": {
      "type": "object",
      "required": ["pretty_name", "id", "kernel"],
      "properties": {
        "pretty_name": { "type": "string" },
        "id": { "type": "string" },
        "kernel": { "type": "string" },
        "is_wayland": { "type": "boolean" }
      }
    },
    "cpu": {
      "type": "object",
      "required": ["model_name", "total_logical_cores", "p_cores", "e_cores", "optimal_threads"],
      "properties": {
        "model_name": { "type": "string" },
        "total_logical_cores": { "type": "integer", "minimum": 1 },
        "p_cores": { "type": "integer", "minimum": 1 },
        "e_cores": { "type": "integer", "minimum": 0 },
        "optimal_threads": { "type": "integer", "minimum": 1 },
        "max_freq_ghz": { "type": "number" }
      }
    },
    "ram": {
      "type": "object",
      "required": ["total_mb", "available_mb", "max_safe_allocation_mb", "safety_ratio"],
      "properties": {
        "total_mb": { "type": "integer", "minimum": 1024 },
        "available_mb": { "type": "integer", "minimum": 0 },
        "max_safe_allocation_mb": { "type": "integer", "minimum": 512 },
        "safety_ratio": { "type": "number", "minimum": 0.1, "maximum": 0.9 }
      }
    },
    "gpu": {
      "type": "object",
      "required": ["device_name", "total_vram_mb", "free_vram_mb", "wayland_guard_vram_mb", "est_bandwidth_gbps"],
      "properties": {
        "device_name": { "type": "string" },
        "total_vram_mb": { "type": "integer", "minimum": 0 },
        "free_vram_mb": { "type": "integer", "minimum": 0 },
        "wayland_guard_vram_mb": { "type": "integer", "minimum": 0 },
        "est_bandwidth_gbps": { "type": "number", "minimum": 0 }
      }
    },
    "storage": {
      "type": "object",
      "required": ["nvme_model", "pcie_link_speed", "pcie_link_width", "est_read_bandwidth_mbps"],
      "properties": {
        "nvme_model": { "type": "string" },
        "pcie_link_speed": { "type": "string" },
        "pcie_link_width": { "type": "integer" },
        "est_read_bandwidth_mbps": { "type": "number" }
      }
    },
    "invariants": {
      "type": "object",
      "required": ["wayland_vram_guard_mb", "ram_rule_42_ratio"],
      "properties": {
        "wayland_vram_guard_mb": { "type": "integer", "const": 7800 },
        "ram_rule_42_ratio": { "type": "number", "const": 0.70 }
      }
    }
  }
}
